# Copie para android/key.properties e preencha. O arquivo key.properties e o
# keystore (.jks) nunca são versionados: estão no .gitignore.
#
# Como criar a chave de envio e onde guardá-la: docs/09-guides/android-release.md

# As duas senhas escolhidas ao criar o keystore.
storePassword=
keyPassword=

# O nome dado à chave ao criá-la (o guia usa "upload").
keyAlias=upload

# Caminho completo do keystore, com barras normais mesmo no Windows:
#   C:/Users/voce/chaves/yvenist-upload.jks
storeFile=
