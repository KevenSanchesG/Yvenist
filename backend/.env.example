# Copie para ".env" e ajuste. O arquivo .env nunca deve ser versionado.

# development | test | production
YVENIST_ENV=development

# SQLite serve para desenvolver sem instalar nada. Em produção use PostgreSQL:
#   postgresql+psycopg://usuario:senha@host:5432/yvenist
YVENIST_DATABASE_URL=sqlite:///./yvenist.db

# Obrigatório em produção, com pelo menos 32 caracteres aleatórios. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# YVENIST_JWT_SECRET=

YVENIST_ACCESS_TOKEN_TTL_MINUTES=15
YVENIST_REFRESH_TOKEN_TTL_DAYS=30

# Origens autorizadas para o app web (separadas por vírgula). Vazio = CORS desligado.
# YVENIST_CORS_ORIGINS=http://localhost:5000

YVENIST_LOG_LEVEL=INFO
