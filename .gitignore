# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Chaves de assinatura do Android: nunca versionar.
*.jks
*.keystore
/android/key.properties

# Backend (Python)
backend/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
backend/*.db

# Configuração local e segredos: só o exemplo é versionado.
.env
.env.*
!.env.example

# Obsidian: a pasta docs/ é um cofre. O comportamento do cofre é versionado
# (app.json, core-plugins.json, templates.json); o que é de cada pessoa ou de
# cada máquina fica de fora.
docs/.obsidian/workspace*.json
docs/.obsidian/appearance.json
docs/.obsidian/hotkeys.json
docs/.obsidian/graph.json
docs/.obsidian/community-plugins.json
docs/.obsidian/core-plugins-migration.json
docs/.obsidian/plugins/
docs/.obsidian/themes/
docs/.obsidian/snippets/
docs/.obsidian/cache
docs/.trash/

# Claude Code: instruções e permissões pessoais. O CLAUDE.md e a pasta
# .claude/ (regras e skills) são do projeto e são versionados.
CLAUDE.local.md
.claude/settings.local.json
