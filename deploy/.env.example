# Copie para deploy/.env e preencha. O arquivo deploy/.env nunca é versionado.

# O endereço público da API, sem "https://". Tem de apontar para este servidor.
YVENIST_API_DOMAIN=api.exemplo.com.br

# Senha do banco. Só letras e números, porque ela entra em uma URL. Gere com:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Segredo que assina as sessões: pelo menos 32 caracteres aleatórios. Trocar
# este valor encerra todas as sessões abertas. Gere com:
#   openssl rand -hex 32
YVENIST_JWT_SECRET=

# Só se a versão web for publicada: as origens dela, com https, separadas por
# vírgula.
# YVENIST_CORS_ORIGINS=https://app.exemplo.com.br

# Só para testar em uma máquina onde as portas 80 e 443 estão ocupadas.
# YVENIST_HTTP_PORT=8080
# YVENIST_HTTPS_PORT=8443
